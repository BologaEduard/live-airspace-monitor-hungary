  "narrative": {
    "northStar": "Night atlas",
    "overview": "Night atlas pairs cool paper surfaces with deep chart fields. Manrope provides a single, precise typographic voice; warm selection and restrained evidence color make state changes legible.\n\nThe material is flat and lightly bounded. Depth comes primarily from tonal separation, with small shadows reserved for floating controls and disclosures.",
    "keyCharacteristics": [
      "Cool paper and deep blue tonal separation.",
      "Amber selection and ice-blue observations.",
      "Compact controls with explicit focus and data-quality states."
    ],
    "rules": [
      {
        "name": "The State Evidence Rule",
        "body": "Pair state color with text, shape, or selection semantics; missing altitude retains its dashed ring even under selection.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do keep selection amber and evidence indicators coral.",
      "Do retain tabular numerals for measurements and timestamps.",
      "Do retain visible focus, reduced-motion support, and explicit unavailable states."
    ],
    "donts": [
      "Don't represent missing telemetry as zero or a normal status.",
      "Don't remove the dashed missing-altitude ring when an aircraft is selected.",
      "Don't use aircraft rotation to imply a known track when track is unavailable."
    ]
  }
